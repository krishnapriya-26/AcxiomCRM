@model IEnumerable<Customer>
<div class="d-flex justify-content-between align-items-center"><h2>Customers</h2><a class="btn btn-primary" asp-action="Create">+ Customer</a></div><form class="row g-2 my-3"><div class="col-md-5"><input name="search" class="form-control" placeholder="Name, email, phone or company"></div><div class="col-auto"><button class="btn btn-outline-secondary">Search</button></div></form><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Code</th><th>Name</th><th>Email</th><th>Phone</th><th>Company</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.CustomerCode</td><td>@x.CustomerName</td><td>@x.Email</td><td>@x.Phone</td><td>@x.CompanyName</td><td>@x.Status</td><td><a asp-action="Edit" asp-route-id="@x.CustomerId">Edit</a> @if(User.IsInRole("Admin")||User.IsInRole("Manager")){<span> | </span><a asp-action="Delete" asp-route-id="@x.CustomerId">Delete</a>}</td></tr>}</tbody></table></div>
