@model Opportunity
<div asp-validation-summary="All" class="text-danger"></div><form method="post"><input asp-for="OpportunityId" type="hidden"><div class="row"><div class="col-md-6 mb-3"><label asp-for="OpportunityName" class="form-label"></label><input asp-for="OpportunityName" class="form-control"><span asp-validation-for="OpportunityName" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="CustomerId" class="form-label">Customer ID</label><input asp-for="CustomerId" class="form-control"></div><div class="col-md-4 mb-3"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control"><span asp-validation-for="Amount" class="text-danger"></span></div><div class="col-md-4 mb-3"><label asp-for="Probability" class="form-label"></label><input asp-for="Probability" class="form-control"><span asp-validation-for="Probability" class="text-danger"></span></div><div class="col-md-4 mb-3"><label asp-for="Stage" class="form-label"></label><select asp-for="Stage" class="form-select"><option>Qualification</option><option>Proposal</option><option>Negotiation</option><option>Won</option><option>Lost</option></select></div><div class="col-md-6 mb-3"><label asp-for="ExpectedCloseDate" class="form-label"></label><input asp-for="ExpectedCloseDate" class="form-control" type="date"><span asp-validation-for="ExpectedCloseDate" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Open</option><option>Closed</option></select></div></div><button class="btn btn-primary">Save</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></form>
