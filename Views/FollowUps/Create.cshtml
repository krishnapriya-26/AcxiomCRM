@model FollowUp
<h2>Create Follow-Up</h2><div asp-validation-summary="All" class="text-danger"></div><form method="post"><div class="row"><div class="col-md-4 mb-3"><label asp-for="FollowUpDate" class="form-label"></label><input asp-for="FollowUpDate" class="form-control" type="date"><span asp-validation-for="FollowUpDate" class="text-danger"></span></div><div class="col-md-4 mb-3"><label asp-for="FollowUpType" class="form-label"></label><select asp-for="FollowUpType" class="form-select"><option>Call</option><option>Meeting</option><option>Email</option><option>Task</option></select></div><div class="col-md-4 mb-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Planned</option><option>Completed</option><option>Missed</option><option>Cancelled</option></select></div><div class="col-md-6 mb-3"><label asp-for="CustomerId" class="form-label">Customer ID</label><input asp-for="CustomerId" class="form-control"></div><div class="col-md-6 mb-3"><label asp-for="LeadId" class="form-label">Lead ID</label><input asp-for="LeadId" class="form-control"></div><div class="mb-3"><label asp-for="Remarks" class="form-label"></label><textarea asp-for="Remarks" class="form-control"></textarea></div></div><button class="btn btn-primary">Save</button></form>
