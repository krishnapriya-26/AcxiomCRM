@model Lead
<div asp-validation-summary="All" class="text-danger"></div><form method="post"><input asp-for="LeadId" type="hidden"><input asp-for="LeadCode" type="hidden"><div class="row"><div class="col-md-6 mb-3"><label asp-for="LeadName" class="form-label"></label><input asp-for="LeadName" class="form-control"><span asp-validation-for="LeadName" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="CompanyName" class="form-label"></label><input asp-for="CompanyName" class="form-control"></div><div class="col-md-6 mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"></div><div class="col-md-6 mb-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control"></div><div class="col-md-4 mb-3"><label asp-for="Source" class="form-label"></label><select asp-for="Source" class="form-select"><option>Website</option><option>Referral</option><option>Advertisement</option><option>Cold Call</option><option>Event</option></select></div><div class="col-md-4 mb-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>New</option><option>Contacted</option><option>Qualified</option><option>Unqualified</option><option>Converted</option><option>Lost</option></select></div><div class="col-md-4 mb-3"><label asp-for="Priority" class="form-label"></label><select asp-for="Priority" class="form-select"><option>Low</option><option>Medium</option><option>High</option></select></div><div class="col-md-6 mb-3"><label asp-for="ExpectedValue" class="form-label"></label><input asp-for="ExpectedValue" class="form-control"><span asp-validation-for="ExpectedValue" class="text-danger"></span></div></div><button class="btn btn-primary">Save</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></form>
