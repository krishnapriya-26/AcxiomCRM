@model IEnumerable<Lead>
<div class="d-flex justify-content-between"><h2>Leads</h2><a class="btn btn-primary" asp-action="Create">+ Lead</a></div><form class="row g-2 my-3"><div class="col-md-4"><input name="search" class="form-control" placeholder="Lead or company"></div><div class="col-md-3"><select name="status" class="form-select"><option value="">All statuses</option><option>New</option><option>Contacted</option><option>Qualified</option><option>Unqualified</option><option>Converted</option><option>Lost</option></select></div><div class="col-auto"><button class="btn btn-outline-secondary">Filter</button></div></form><table class="table table-hover"><thead><tr><th>Code</th><th>Name</th><th>Company</th><th>Source</th><th>Status</th><th>Priority</th><th>Value</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.LeadCode</td><td>@x.LeadName</td><td>@x.CompanyName</td><td>@x.Source</td><td>@x.Status</td><td>@x.Priority</td><td>₹@x.ExpectedValue.ToString("N2")</td><td><a asp-action="Edit" asp-route-id="@x.LeadId">Edit</a></td></tr>}</tbody></table>
