@model IEnumerable<Activity>
<div class="d-flex justify-content-between"><h2>Activities</h2><a class="btn btn-primary" asp-action="Create">+ Activity</a></div><table class="table table-hover mt-3"><thead><tr><th>Date</th><th>Type</th><th>Subject</th><th>Status</th><th>Customer</th><th>Lead</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.ActivityDate.ToString("dd-MM-yyyy")</td><td>@x.ActivityType</td><td>@x.Subject</td><td>@x.Status</td><td>@x.CustomerId</td><td>@x.LeadId</td></tr>}</tbody></table>
