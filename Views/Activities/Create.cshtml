@model Activity
<h2>Create Activity</h2><div asp-validation-summary="All" class="text-danger"></div><form method="post"><div class="row"><div class="col-md-4 mb-3"><label asp-for="ActivityType" class="form-label"></label><select asp-for="ActivityType" class="form-select"><option>Call</option><option>Meeting</option><option>Email</option><option>Task</option></select></div><div class="col-md-8 mb-3"><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" class="form-control"><span asp-validation-for="Subject" class="text-danger"></span></div><div class="col-md-4 mb-3"><label asp-for="ActivityDate" class="form-label"></label><input asp-for="ActivityDate" class="form-control" type="date"></div><div class="col-md-4 mb-3"><label asp-for="CustomerId" class="form-label">Customer ID</label><input asp-for="CustomerId" class="form-control"></div><div class="col-md-4 mb-3"><label asp-for="LeadId" class="form-label">Lead ID</label><input asp-for="LeadId" class="form-control"></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div></div><button class="btn btn-primary">Save</button></form>
