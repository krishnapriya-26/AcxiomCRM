@model IEnumerable<Opportunity>
<div class="d-flex justify-content-between"><h2>Opportunities</h2><a class="btn btn-primary" asp-action="Create">+ Opportunity</a></div><form class="row g-2 my-3"><div class="col-md-4"><input name="search" class="form-control" placeholder="Opportunity name"></div><div class="col-md-3"><select name="stage" class="form-select"><option value="">All stages</option><option>Qualification</option><option>Proposal</option><option>Negotiation</option><option>Won</option><option>Lost</option></select></div><div class="col-auto"><button class="btn btn-outline-secondary">Filter</button></div></form><table class="table table-hover"><thead><tr><th>Name</th><th>Amount</th><th>Probability</th><th>Weighted</th><th>Stage</th><th>Close Date</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.OpportunityName</td><td>₹@x.Amount.ToString("N2")</td><td>@x.Probability%</td><td>₹@x.WeightedPipeline.ToString("N2")</td><td>@x.Stage</td><td>@x.ExpectedCloseDate.ToString("dd-MM-yyyy")</td><td>@x.Status</td><td><a asp-action="Edit" asp-route-id="@x.OpportunityId">Edit</a></td></tr>}</tbody></table>
