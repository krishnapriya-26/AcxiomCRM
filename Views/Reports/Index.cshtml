<h2>Reports</h2><div class="row g-4"><div class="col-md-6"><div class="card"><div class="card-body"><h5>Lead Report</h5><table class="table"><thead><tr><th>Status</th><th>Count</th><th>Expected Value</th></tr></thead><tbody>@foreach(var x in ViewBag.Leads){<tr><td>@x.Status</td><td>@x.Count</td><td>₹@x.Value.ToString("N2")</td></tr>}</tbody></table></div></div></div><div class="col-md-6"><div class="card"><div class="card-body"><h5>Opportunity Pipeline Report</h5><table class="table"><thead><tr><th>Stage</th><th>Count</th><th>Amount</th><th>Weighted</th></tr></thead><tbody>@foreach(var x in ViewBag.Opportunities){<tr><td>@x.Stage</td><td>@x.Count</td><td>₹@x.Amount.ToString("N2")</td><td>₹@x.Weighted.ToString("N2")</td></tr>}</tbody></table></div></div></div></div>
