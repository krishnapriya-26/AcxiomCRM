@model IEnumerable<AuditLog>
<h2>Audit Log</h2><form class="row g-2 my-3"><div class="col-md-3"><input name="action" class="form-control" placeholder="Action"></div><div class="col-md-3"><input name="entity" class="form-control" placeholder="Entity"></div><div class="col-auto"><button class="btn btn-outline-secondary">Filter</button></div></form><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Date</th><th>User</th><th>Action</th><th>Entity</th><th>Record</th><th>Result</th><th>IP</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.CreatedDate.ToLocalTime().ToString("g")</td><td>@x.UserId</td><td>@x.Action</td><td>@x.EntityName</td><td>@x.RecordId</td><td>@x.Result</td><td>@x.IpAddress</td></tr>}</tbody></table></div>
