@model DashboardViewModel
<h1 class="mb-4">Dashboard</h1><div class="row g-3">@foreach(var item in new[]{("Customers",Model.TotalCustomers,"primary"),("Leads",Model.TotalLeads,"success"),("Open Leads",Model.OpenLeads,"info"),("Opportunities",Model.TotalOpportunities,"warning"),("Open Opportunities",Model.OpenOpportunities,"secondary"),("Won",Model.WonOpportunities,"success"),("Lost",Model.LostOpportunities,"danger")}){<div class="col-md-3"><div class="card text-bg-@item.Item3 h-100"><div class="card-body"><div class="small">@item.Item1</div><div class="display-6">@item.Item2</div></div></div></div>}<div class="col-md-4"><div class="card h-100"><div class="card-body"><div class="text-muted">Open Pipeline Value</div><div class="display-6">₹@Model.TotalPipelineValue.ToString("N2")</div></div></div></div></div><div class="row g-4 mt-2"><div class="col-md-6"><div class="card"><div class="card-body"><h5>Lead Status</h5><canvas id="leadChart"></canvas></div></div></div><div class="col-md-6"><div class="card"><div class="card-body"><h5>Opportunity Pipeline</h5><canvas id="oppChart"></canvas></div></div></div></div><script>new Chart(document.getElementById('leadChart'),{type:'doughnut',data:{labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatuses.Keys)),datasets:[{data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatuses.Values))}]}});new Chart(document.getElementById('oppChart'),{type:'bar',data:{labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpportunityStages.Keys)),datasets:[{label:'Opportunities',data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpportunityStages.Values))}]}});</script>
