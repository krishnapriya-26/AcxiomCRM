@model IEnumerable<FollowUp>
<div class="d-flex justify-content-between"><h2>Follow-Ups</h2><a class="btn btn-primary" asp-action="Create">+ Follow-Up</a></div><table class="table table-hover mt-3"><thead><tr><th>Date</th><th>Type</th><th>Customer</th><th>Lead</th><th>Status</th><th>Remarks</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr class="@(x.FollowUpDate.Date<DateTime.Today&&x.Status=="Planned"?"table-danger":"")"><td>@x.FollowUpDate.ToString("dd-MM-yyyy")</td><td>@x.FollowUpType</td><td>@x.CustomerId</td><td>@x.LeadId</td><td>@x.Status</td><td>@x.Remarks</td><td>@if(x.Status=="Planned"){<form asp-action="Complete" method="post" class="d-inline"><input type="hidden" name="id" value="@x.FollowUpId"><button class="btn btn-sm btn-success">Complete</button></form>}</td></tr>}</tbody></table>
