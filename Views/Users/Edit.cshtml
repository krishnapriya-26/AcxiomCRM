@model ApplicationUser
<h2>Manage User</h2><form method="post"><input type="hidden" name="id" value="@Model.Id"><div class="mb-3"><label class="form-label">User</label><input class="form-control" value="@Model.Email" disabled></div><div class="mb-3"><label class="form-label">Role</label><select name="role" class="form-select">@foreach(string r in ViewBag.Roles){<option selected="@(r==(string?)ViewBag.CurrentRole)">@r</option>}</select></div><div class="form-check mb-3"><input type="checkbox" name="isActive" value="true" class="form-check-input" checked="@Model.IsActive"><input type="hidden" name="isActive" value="false"><label class="form-check-label">Active</label></div><button class="btn btn-primary">Save</button></form>
